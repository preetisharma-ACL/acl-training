# ── Aajneeti Academy — environment variables ──
# Copy to .env and fill in. One file serves both the frontend (Vite) and the
# backend (Express). Vite only exposes variables prefixed with VITE_ to the
# browser, so server secrets below never reach the bundle.

# development | test | production
NODE_ENV=development
# Port the Express API listens on
PORT=5000

# PostgreSQL connection strings
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/acl_training?schema=public
# Separate database used by `npm test` (it is wiped between test runs)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/acl_training_test?schema=public

# Session cookie signing secret: long and random, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me
# Session lifetime without "Keep me signed in" (hours, sliding)
SESSION_HOURS=12
# Session lifetime with "Keep me signed in" (days)
REMEMBER_ME_DAYS=14

# Browser origins allowed to call the API (comma-separated). State-changing
# requests from any other Origin are rejected (CSRF protection).
APP_ORIGINS=http://localhost:5174
# Set to 1 when running behind a reverse proxy / load balancer that
# terminates HTTPS (needed for Secure cookies and correct client IPs).
TRUST_PROXY=0
# Production only: serve the built frontend (dist/) from Express. Default 1.
SERVE_FRONTEND=1

# Private file storage for uploaded PDFs (never publicly served)
STORAGE_DIR=server/storage
MAX_UPLOAD_MB=25

# Development seed passwords (npm run db:seed). The seed refuses to run
# when NODE_ENV=production. Create real admins with `npm run admin:create`.
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
# true = also create 24 sample employees (password: SEED_EMPLOYEE_PASSWORD)
SEED_SAMPLE_EMPLOYEES=false

# ── Frontend (exposed to the browser) ──
# API base. "/api/v1" uses the Vite dev proxy (same origin as production).
VITE_API_URL=/api/v1
# true = run the UI against the in-browser mock database; false = real API
VITE_USE_MOCK=false
