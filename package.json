{
  "name": "acl-training",
  "private": true,
  "version": "0.1.0",
  "description": "Aajneeti Academy — training & assessment portal (SolidJS frontend + Express/Prisma backend)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --watch-path=server/src server/src/server.js",
    "server:start": "node server/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:create": "node server/scripts/create-admin.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-solid": "^0.577.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "solid-js": "^1.8.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.8.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.12"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma",
    "seed": "node server/prisma/seed.js"
  }
}
