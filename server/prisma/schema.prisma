// Aajneeti Academy — database schema.
//
// Rules the schema carries:
//   • An employee's department AND level come from their designation. Users
//     have no department/level column on purpose.
//   • Attempts snapshot their questions, options and answer key, so editing
//     or deleting the question bank never changes a past result.
//   • Attempts are voided (not deleted) when an admin resets them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Level {
  TEAM_HEAD
  SENIOR
  JUNIOR
}

enum MaterialType {
  PDF
  MANUAL
  STRUCTURED_GUIDE
  MEDIA
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

// ── People & organisation ───────────────────────────────────────────────────

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique // stored lower-case
  passwordHash       String
  phone              String        @default("")
  employeeCode       String?       @unique
  location           String        @default("")
  joinedAt           DateTime?
  bio                String        @default("")
  role               Role          @default(EMPLOYEE)
  status             AccountStatus @default(ACTIVE)
  adminTitle         String?
  designationId      String?
  preferences        Json          @default("{}")
  mustChangePassword Boolean       @default(false)
  // Bumped on password change / admin reset / deactivation: every session
  // minted with an older value stops working.
  authVersion        Int           @default(0)
  lastLoginAt        DateTime?
  lastActiveAt       DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  designation      Designation?           @relation(fields: [designationId], references: [id], onDelete: Restrict)
  progress         MaterialProgress[]
  attempts         Attempt[]              @relation("AttemptUser")
  voidedAttempts   Attempt[]              @relation("AttemptVoidedBy")
  resetTokens      PasswordResetToken[]
  resetRequests    PasswordResetRequest[]
  auditLogs        AuditLog[]
  materialsCreated Material[]
  materialVersions MaterialVersion[]
  announcements    Announcement[]

  @@index([designationId])
  @@index([role, status])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  head        String   @default("")
  location    String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  designations  Designation[]
  materials     Material[]
  assessments   Assessment[]
  announcements AnnouncementDepartment[]
}

// Office locations an admin can assign to people and departments. User and
// Department keep the name as text; renames cascade to them, and a location
// can't be deleted while anyone still uses it.
model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designation {
  id           String   @id @default(cuid())
  title        String   @unique
  departmentId String
  level        Level
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users      User[]

  @@index([departmentId, level])
}

// ── Training materials ──────────────────────────────────────────────────────

model Material {
  id          String            @id @default(cuid())
  title       String
  description String            @default("")
  type        MaterialType
  // null = company-wide
  departmentId String?
  // manual → { chapters }, structured → { intro, sections }, media → { url, kind }
  content     Json?
  // Private storage reference (never a public URL) + metadata, PDFs only.
  fileKey     String?
  fileName    String?
  fileMime    String?
  fileSize    Int?
  filePages   Int?
  estMinutes  Int               @default(5)
  required    Boolean           @default(true)
  status      PublicationStatus @default(PUBLISHED)
  // Display version ("2.1") and an integer revision for completion rules:
  // progress counts as complete only if completedRevision >= requiredRevision.
  version          String       @default("1.0")
  revision         Int          @default(1)
  requiredRevision Int          @default(1)
  author      String            @default("")
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  department Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  levels     MaterialLevel[]
  progress   MaterialProgress[]
  versions   MaterialVersion[]

  @@index([departmentId, status])
}

// Which levels a material is assigned to (all three by default).
model MaterialLevel {
  materialId String
  level      Level

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([materialId, level])
  @@index([level])
}

model MaterialVersion {
  id          String       @id @default(cuid())
  materialId  String
  revision    Int
  version     String
  title       String
  description String
  type        MaterialType
  content     Json?
  fileKey     String?
  fileName    String?
  fileSize    Int?
  createdById String?
  createdAt   DateTime     @default(now())

  material  Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([materialId, revision])
}

model MaterialProgress {
  id                String    @id @default(cuid())
  userId            String
  materialId        String
  percent           Int       @default(0)
  completed         Boolean   @default(false)
  startedAt         DateTime  @default(now())
  lastOpenedAt      DateTime  @default(now())
  completedAt       DateTime?
  completedRevision Int?
  completedVersion  String?
  // Completion evidence, recorded by the server for the revision being read
  // (reset when a new revision appears before completion):
  //   activeSeconds — reading time from server-timed heartbeats (gaps capped)
  //   seenSections  — manual chapter / guide section ids seen (validated)
  //   fileOpenedAt  — when the PDF itself was streamed to this employee
  trackedRevision   Int?
  activeSeconds     Int       @default(0)
  lastPingAt        DateTime?
  seenSections      Json      @default("[]")
  fileOpenedAt      DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
}

// ── Assessments ─────────────────────────────────────────────────────────────

// One per department per level.
model Assessment {
  id                  String   @id @default(cuid())
  departmentId        String
  level               Level
  title               String
  description         String   @default("")
  durationSeconds     Int      @default(600)
  passPercent         Int      @default(70)
  marksPerQuestion    Int      @default(1)
  maxAttempts         Int      @default(3)
  questionsPerAttempt Int      @default(5)
  shuffle             Boolean  @default(true)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  questions  Question[]
  attempts   Attempt[]

  @@unique([departmentId, level])
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String
  text         String
  type         QuestionType @default(MULTIPLE_CHOICE)
  explanation  String       @default("")
  difficulty   Difficulty   @default(MEDIUM)
  active       Boolean      @default(true)
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment       Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  options          QuestionOption[]
  attemptQuestions AttemptQuestion[]

  @@index([assessmentId, active])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

model Attempt {
  id              String        @id @default(cuid())
  userId          String
  assessmentId    String
  attemptNumber   Int
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?
  timeTakenSeconds Int?
  focusViolations Int           @default(0)
  autoSubmitted   Boolean       @default(false)
  // Result (null until graded)
  marks           Int?
  totalMarks      Int?
  totalQuestions  Int
  correctCount    Int?
  incorrectCount  Int?
  unansweredCount Int?
  percentage      Float?
  passed          Boolean?
  // Settings, department, level and designation as they were at start.
  config          Json
  // Admin "reset attempts": kept for history, no longer counts.
  voidedAt        DateTime?
  voidedById      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user       User              @relation("AttemptUser", fields: [userId], references: [id], onDelete: Restrict)
  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("AttemptVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  questions  AttemptQuestion[]
  answers    AttemptAnswer[]

  @@unique([userId, assessmentId, attemptNumber])
  @@index([userId, status])
  @@index([assessmentId, status])
  @@index([submittedAt])
}

// Immutable snapshot of one question as the candidate saw it.
model AttemptQuestion {
  id              String  @id @default(cuid())
  attemptId       String
  questionId      String? // the bank question; null if later deleted
  position        Int
  text            String
  explanation     String  @default("")
  // [{ id, text }] in display order
  options         Json
  // Private answer key. Never sent to employees before submission.
  correctOptionId String

  attempt  Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answer   AttemptAnswer?

  @@unique([attemptId, position])
  @@index([questionId])
}

model AttemptAnswer {
  id                String    @id @default(cuid())
  attemptId         String
  attemptQuestionId String    @unique
  selectedOptionId  String?
  isCorrect         Boolean?
  answeredAt        DateTime  @default(now())

  attempt         Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestion AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// ── Announcements ───────────────────────────────────────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  tone        String    @default("lime")
  published   Boolean   @default(true)
  publishedAt DateTime?
  archivedAt  DateTime?
  authorId    String?
  authorName  String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author      User?                    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Empty = every employee.
  departments AnnouncementDepartment[]

  @@index([published, archivedAt])
}

model AnnouncementDepartment {
  announcementId String
  departmentId   String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([announcementId, departmentId])
}

// ── Security ────────────────────────────────────────────────────────────────

// Single-use reset tokens (only the SHA-256 hash is stored). Issued only once
// an email transport is configured; unused until then.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Forgot password" without email: admins see the request and reset the
// password themselves.
model PasswordResetRequest {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json     @default("{}")
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
}

// Owned by connect-pg-simple (express-session store); kept here so
// migrations create it.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
